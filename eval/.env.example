# Evaluation workbench only — this package serves no user traffic.
# Runtime configuration (Supabase URL/keys) belongs to the frontend and Edge Functions,
# not here.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Required to run the golden-set benchmark against a live model (Constitution IV).
# Leave blank to run the offline suite, which injects FakeLLMClient and makes no calls.
OPENROUTER_API_KEY=

# Active pipeline config, relative to eval/ (Constitution IV).
PIPELINE_CONFIG=pipelines/v1.yaml
