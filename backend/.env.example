ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/writewise

OPENROUTER_API_KEY=

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FAILED_SIGNIN_WINDOW_MINUTES=15
FAILED_SIGNIN_MAX_ATTEMPTS=5

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
